# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
CHA_PROCESS_ROLE=web

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Closed editorial pilot. Leave unset to disable publication writes.
# Use a unique random token of at least 32 characters; never reuse APP_KEY.
PILOT_EDITOR_TOKEN=
PILOT_EDITOR_ID=
PILOT_EDITOR_NAME=

# Persistence (local Docker defaults only)
CLAIM_REPOSITORY=memory
PUBLICATION_REPOSITORY=memory
COMMUNITY_REPOSITORY=memory
ASSISTANCE_RETRIEVER=memory
STATISTICS_REPOSITORY=memory
PLACE_REPOSITORY=memory
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=chile_historia_abierta
# Local migration/owner connection only. Production web processes must omit both.
DB_ADMIN_USER=cha_owner
DB_ADMIN_PASSWORD=local_owner_password
DB_PUBLIC_USER=cha_public
DB_PUBLIC_PASSWORD=local_public_password

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
