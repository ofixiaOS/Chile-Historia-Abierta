# Environment and secrets (preserving examples and test configs)
platform/.env
platform/.env.local
platform/.env.production.local
platform/.env.development.local
*.env
*.env.*
!platform/.env.example


# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
